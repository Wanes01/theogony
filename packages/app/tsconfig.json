{
  "extends": "@theogony/config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@model/*": ["../shared/src/model/*"],
      "@icons": ["./src/components/ui/icons"],
      "@icons/*": ["./src/components/ui/icons/*"]
    },
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
